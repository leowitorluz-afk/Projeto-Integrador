  m_Script: {fileID: 11500000, guid: 57c6772efd8cde24f94b75671272999a, type: 3}
  m_Name: Question1
  m_EditorClassIdentifier: 
  questionText: "Voc\xEA precisa dar um toque s\xE9rio em um colega que \xE9 meio
    teimoso e n\xE3o gosta de ouvir cr\xEDtica. Como voc\xEA faz isso pra ele realmente
    te escutar e mudar algo?"
  answers:
  - "Mandar um e-mail longo pra n\xE3o ter que encarar a pessoa"
  - "S\xF3 jogar os n\xFAmeros e fatos na cara dele, sem muita conversa"
  - "Come\xE7ar com uns elogios falsos e depois soltar a bomba na lata"
  - "Chamar pra um papo, focar no que pode melhorar, falar como a situa\xE7\xE3o
    te afeta e bolar um plano junto"
  correctAnswerIndex: 3
